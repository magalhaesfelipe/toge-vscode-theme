	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#db757a" }
		},
		{
			"name": "Strings",
			"scope": ["string", "string.regexp", "constant.other.symbol"],
			"settings": { "foreground": "#DAC0A7" } // Ivory Cream
		},
		{
			"name": "Strings: Escape Sequences",
			"scope": "constant.character.escape",
			"settings": { "foreground": "#807966" } // Ivory Stone
		},
		{
			"name": "Numbers, Characters",
			"scope": [
				"constant.numeric",
				"constant.character",
				"constant.keyword",
				"constant"
			],
			"settings": { "foreground": "#D4976C" } // Clay
		},
		{
			"name": "Global definitions",
			"scope": "entity.name",
			"settings": { "foreground": "#EFDFBB" } // Dutch White
		},
		{
			"name": "Punctuation",
			"scope": "punctuation",
			"settings": { "foreground": "#807966" } // Ivory Stone
		},
		{
			"name": "Invalid",
			"scope": "invalid",
			"settings": { "foreground": "#DF334A" }
		},
		{
			"name": "Extra: Diff Range",
			"scope": ["meta.diff.range", "meta.diff.index", "meta.separator"],
			"settings": { "foreground": "#D7CEB3" }
		},
		{
			"name": "Extra: Diff From",
			"scope": "meta.diff.header.from-file",
			"settings": { "foreground": "#D7CEB3" }
		},
		{
			"name": "Extra: Diff To",
			"scope": "meta.diff.header.to-file",
			"settings": { "foreground": "#D7CEB3" }
		},
		{
			"name": "Keywords, control flow",
			"scope": [
				"keyword",
				"keyword.control",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": { "foreground": "#F5DEB3" } // Wheat
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator", "punctuation.separator.key-value"],
			"settings": { "foreground": "#B09B8C" } // Ivory Brown
		},
		{
			"name": "Function calls (plain, Alabaster-style)",
			"scope": [
				"meta.function-call entity.name.function",
				"variable.function",
				"support.function"
			],
			"settings": { "foreground": "#C2BBA8" } // Ivory Gray, same as editor.foreground
		},
		{
			"name": "Built-ins and support",
			"scope": [
				"support.function.builtin",
				"support.constant",
				"support.variable",
				"variable.language"
			],
			"settings": { "foreground": "#E8B4A0" } // Terracotta rose
		},
		{
			"name": "Types, classes, interfaces",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.other.inherited-class",
				"support.type",
				"support.class"
			],
			"settings": { "foreground": "#F3DCCE" } // Ivory Satin
		},
		{
			"name": "Namespaces, modules",
			"scope": [
				"entity.name.namespace",
				"entity.name.module",
				"support.module"
			],
			"settings": { "foreground": "#EBDDBE" } // Ivory Beige
		},
		{
			"name": "Variables",
			"scope": ["variable", "meta.definition.variable"],
			"settings": { "foreground": "#E3DAC9" } // Bone
		},
		{
			"name": "Parameters",
			"scope": ["variable.parameter", "meta.parameter"],
			"settings": { "foreground": "#E6D4C5" } // Ivory Silk
		},
		{
			"name": "Properties, object keys",
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"meta.object-literal.key",
				"support.type.property-name"
			],
			"settings": { "foreground": "#DCD1AE" } // Old Ivory
		},
		{
			"name": "Decorators, annotations",
			"scope": [
				"meta.decorator",
				"entity.name.function.decorator",
				"storage.type.annotation"
			],
			"settings": { "foreground": "#DBC3BE" } // Pink Ivory
		},
		{
			"name": "Tags (HTML/JSX)",
			"scope": ["entity.name.tag", "support.class.component"],
			"settings": { "foreground": "#FFDAB9" } // Peach Puff
		},
		{
			"name": "Tag attributes",
			"scope": "entity.other.attribute-name",
			"settings": { "foreground": "#D8CFBA" } // Sandstone Ivory
		},
		{
			"name": "CSS selectors, classes, ids",
			"scope": [
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css",
				"entity.name.tag.css"
			],
			"settings": { "foreground": "#F2E4C5" } // Ivory Castle
		},
		{
			"name": "CSS values, units, colors",
			"scope": [
				"support.constant.property-value",
				"keyword.other.unit",
				"constant.other.color"
			],
			"settings": { "foreground": "#D4976C" } // Clay
		},
		{
			"name": "Template interpolation",
			"scope": [
				"punctuation.definition.template-expression",
				"punctuation.section.embedded"
			],
			"settings": { "foreground": "#B09B8C" } // Ivory Brown
		},
		{
			"name": "Markup headings",
			"scope": [
				"markup.heading",
				"entity.name.section",
				"punctuation.definition.heading"
			],
			"settings": { "foreground": "#EFDFBB" } // Dutch White
		},
		{
			"name": "Markup bold",
			"scope": "markup.bold",
			"settings": { "foreground": "#F7E7CE" } // Champagne
		},
		{
			"name": "Markup italic",
			"scope": "markup.italic",
			"settings": { "foreground": "#EEE1CB", "fontStyle": "italic" } // Ivory Linen
		},
		{
			"name": "Markup code",
			"scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
			"settings": { "foreground": "#DAC0A7" } // Ivory Cream
		},
		{
			"name": "Markup links",
			"scope": ["markup.underline.link", "string.other.link", "meta.link"],
			"settings": { "foreground": "#E8B4A0" } // Terracotta rose
		},
		{
			"name": "Markup quotes, lists",
			"scope": [
				"markup.quote",
				"punctuation.definition.list.begin",
				"markup.list"
			],
			"settings": { "foreground": "#807966" } // Ivory Stone
		},
		{
			"name": "Diff inserted",
			"scope": ["markup.inserted", "meta.diff.header.inserted"],
			"settings": { "foreground": "#F3E5AB" } // Vanilla
		},
		{
			"name": "Diff deleted",
			"scope": ["markup.deleted", "meta.diff.header.deleted"],
			"settings": { "foreground": "#db757a" }
		}
	]
}
